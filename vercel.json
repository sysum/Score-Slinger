{
  "buildCommand": "EXPO_PUBLIC_VERCEL_ENV=$VERCEL_ENV EXPO_PUBLIC_COMMIT_SHA=$VERCEL_GIT_COMMIT_SHA npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
