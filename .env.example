# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — local dev uses the LOCAL Supabase stack (Supabase CLI + Docker),
# not the production project. Run `npm run db:start`, then get the keys with:
#   supabase status -o env
# (SERVICE_ROLE_KEY and ANON_KEY — well-known local demo keys, not secrets).
# Production values (Project Settings > API) live in .env.prod-reference
# (gitignored); switching to prod is a deliberate `cp .env.prod-reference .env`.
# Prod: SUPABASE_URL=https://xxxx.supabase.co

# Supabase — server-side only (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Locally: the service-role demo key from
# `supabase status -o env`. Prod: a Supabase secret key (sb_secret_...) stored as a
# Vercel Secret — the variable name is kept for compatibility.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status -o env`>

# Supabase — client-side (safe to expose, used by Expo app)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>

# The public domain this app is served from (no protocol)
# Local dev:   localhost:5055
# Production:  yourapp.vercel.app
EXPO_PUBLIC_DOMAIN=localhost:5055

# Comma-separated allowed CORS origins for production (leave unset locally)
# ALLOWED_ORIGINS=https://yourapp.vercel.app

# PostHog analytics — client-safe (leave unset to disable analytics)
# Project Settings > Project API Key
# Local dev + preview: use the Non-Prod PostHog project's key.
# Only production should use the prod project's key.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # optional, this is the default
