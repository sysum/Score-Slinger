# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — local dev uses the LOCAL Supabase stack (Supabase CLI + Docker),
# not the production project. Run `npm run db:start`, then get the keys with:
#   supabase status -o env
# (SERVICE_ROLE_KEY and ANON_KEY — well-known local demo keys, not secrets).
# Production values (Project Settings > API) live in .env.prod-reference
# (gitignored); switching to prod is a deliberate `cp .env.prod-reference .env`.
# Prod: SUPABASE_URL=https://xxxx.supabase.co

# Supabase — server-side only (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Locally: the service-role demo key from
# `supabase status -o env`. Prod: a Supabase secret key (sb_secret_...) stored as a
# Vercel Secret — the variable name is kept for compatibility.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status -o env`>

# Supabase — client-side (safe to expose, used by Expo app)
# EXPO_PUBLIC_SUPABASE_ANON_KEY: locally the anon demo key. Prod: a Supabase publishable key
# (sb_publishable_...) — the variable name is kept for compatibility. Legacy JWT keys are
# disabled in prod.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status -o env`>

# The public domain this app is served from (no protocol)
# Local dev:   localhost:5055
# Production:  yourapp.vercel.app
EXPO_PUBLIC_DOMAIN=localhost:5055

# Comma-separated allowed CORS origins for production (leave unset locally)
# ALLOWED_ORIGINS=https://yourapp.vercel.app

# PostHog analytics — client-safe (leave unset to disable analytics)
# Project Settings > Project API Key
# Local dev + preview: use the Non-Prod PostHog project's key.
# Only production should use the prod project's key.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # optional, this is the default
# EXPO_PUBLIC_POSTHOG_DEBUG=true   # optional, verbose PostHog SDK logging

# Sentry — API errors, traces and structured logs (Sentry project: score-slinger-api).
# Leave unset locally: with no DSN the server SDK is a silent no-op (logs still
# print to the console). Set it in Vercel for Production + Preview; the
# environment comes from VERCEL_ENV and the release from VERCEL_GIT_COMMIT_SHA.
# A DSN is not a secret (it can only send events), but this one is used
# server-side only, so it has no EXPO_PUBLIC_ prefix.
# Sentry > Settings > Projects > score-slinger-api > Client Keys (DSN)
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# SENTRY_RELEASE=   # optional override; defaults to VERCEL_GIT_COMMIT_SHA

# Sentry — client errors, traces and logs (Sentry project: score-slinger-web).
# Client-safe (a DSN can only send events); baked into the web bundle at build
# time, so changing it needs a redeploy without build cache. Leave unset locally:
# with no DSN, lib/monitoring.ts never calls Sentry.init (no instrumentation, no
# trace headers, nothing sent). Set it in Vercel for Production + Preview.
# Sentry > Settings > Projects > score-slinger-web > Client Keys (DSN)
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>

# Sentry source-map upload — Vercel build only (`npm run build:web`); never set
# locally (don't run builds locally). With no SENTRY_AUTH_TOKEN the upload is
# skipped; the .map files are deleted from dist/ either way.
# SENTRY_AUTH_TOKEN=sntrys_...   # secret (Vercel Sensitive), org auth token
# SENTRY_ORG=team-beam
# SENTRY_PROJECT=score-slinger-web
