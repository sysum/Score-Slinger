{
  "expo": {
    "name": "Score Slinger",
    "slug": "scoreslinger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scoreslinger",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#01051D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scoreslinger.app"
    },
    "android": {
      "package": "com.scoreslinger.app",
      "adaptiveIcon": {
        "backgroundColor": "#01051D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
